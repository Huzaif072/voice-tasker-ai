# Database
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/voicetasker

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set true to request offline Calendar scope during Google OAuth.
GOOGLE_CALENDAR_ENABLED=false
# Keep false for read-only calendar matching. Set true only after enabling the
# Google Calendar API, updating consent, and reauthenticating affected users.
GOOGLE_CALENDAR_WRITE_ENABLED=false
NEXT_PUBLIC_APPLE_SIGN_IN_ENABLED=false
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Store the contents of the Apple .p8 key with literal \\n converted to newlines.
APPLE_PRIVATE_KEY=
# Optional override; defaults to NEXTAUTH_URL/api/auth/apple/callback
APPLE_REDIRECT_URI=

# AI
GROQ_API_KEY=

# Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=hello@voicetasker.ai

# Email
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your_resend_api_key

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional Sentry monitoring. Keep server and browser DSNs separate.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_RELEASE=
# Only CI/deployment builds should set these server-side values to upload source maps.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_RELEASE=
# Optional separate Socket.IO service. Enable after deploying realtime/server.ts.
NEXT_PUBLIC_SOCKET_ENABLED=false
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
# Server-only URL used by Next.js mutation routes to publish events.
SOCKET_SERVER_URL=http://localhost:3001
# Use the same long random value in the Next.js app and the Socket.IO service.
SOCKET_INTERNAL_TOKEN=replace-with-a-long-random-secret
# Comma-separated browser origins accepted by the Socket.IO service.
SOCKET_CORS_ORIGINS=http://localhost:3000

# Local Whisper fallback
WHISPER_CPP_PATH=/path/to/whisper.cpp/main
WHISPER_MODEL_PATH=/path/to/models/small.en.bin

# Deployed scheduler callback. Keep this value server-side and send it as:
# Authorization: Bearer $REMINDER_WORKER_SECRET
REMINDER_WORKER_SECRET=replace-with-a-long-random-secret
# Context scheduler uses the same protected worker secret at /api/scheduled/context.
# Open-Meteo is used without an API key; attribute Open-Meteo in product documentation.
# Optional Twilio SMS delegation.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
