# Database
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/voicetasker

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set true only after Apple OAuth credentials and callback configuration are ready.
NEXT_PUBLIC_APPLE_SIGN_IN_ENABLED=false
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Store the contents of the Apple .p8 key with literal \\n converted to newlines.
APPLE_PRIVATE_KEY=
# Optional override; defaults to NEXTAUTH_URL/api/auth/apple/callback
APPLE_REDIRECT_URI=

# AI
GROQ_API_KEY=

# Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=hello@voicetasker.ai

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=https://YOUR_PUBLIC_DOMAIN/api/auth/apple/callback

# Email
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your_resend_api_key

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Local Whisper fallback
WHISPER_CPP_PATH=/path/to/whisper.cpp/main
WHISPER_MODEL_PATH=/path/to/models/small.en.bin

NEXT_PUBLIC_APPLE_SIGN_IN_ENABLED=false